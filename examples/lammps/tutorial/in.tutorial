# Toy aspirin, 300 K then 3000 K. Use Run with FFAST to add monitoring.
# The gate and pacing are tutorial-only; verified on LAMMPS 22 Jul 2025 Update 6.
units metal
atom_style atomic
boundary s s s
read_data ../aspirin.data
pair_style lj/cut 6.0
pair_coeff * * 0.002 1.0
velocity all create 300.0 4242 mom yes rot yes
fix nve all nve
fix tether all spring/self 5.0
fix heat all langevin 300.0 300.0 0.05 4242
timestep 0.0005
thermo 5000
# tutorial only: slows the run so you can watch it
run 10000 every 100 "shell sleep 0.3"
# tutorial only: waits before the heat; STOP also releases the shell wait
shell while [ ! -e ${ffast_dir}/GO ] && [ ! -e ${ffast_dir}/STOP ]; do sleep 0.1; done
unfix heat
velocity all scale 3000.0
fix heat all langevin 3000.0 3000.0 0.05 4242
run 40000 every 100 "shell sleep 0.3"
