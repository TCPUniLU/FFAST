# Stop proof (plan step 4): the toy aspirin at 300 K, then suddenly at
# ${hot} K, so the reference (fitted at 300 K) sees frames it was not
# trained on. Two run commands, the second with a variable; no restart
# command, so FFAST should warn that a stopped run cannot be continued.
units           metal
atom_style      atomic
boundary        s s s
variable        data index aspirin.data
read_data       ${data}
read_data       /home/users/USER/ffast_lammps_live/stop/results/2023/toy.data
Reading data file ...
  orthogonal box = (25.4457 46.0314 13.1411) to (48.7927 73.7369 38.5788)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  21 atoms
  read_data CPU = 0.027 seconds
pair_style      lj/cut 6.0
pair_coeff      * * 0.002 1.0
velocity        all create 300.0 4242 mom yes rot yes
fix             nve all nve
fix             tether all spring/self 5.0
fix             heat all langevin 300.0 300.0 0.05 4242
timestep        0.0005
thermo          5000
variable        n1 index 10000
variable        n2 index 40000
variable        hot index 3000
variable        ffast_include index aspirin.lmp
include         ${ffast_include}
include         /home/users/USER/ffast_lammps_live/stop/results/2023/toy.lmp
# Written by `ffast bundle`. Reference bundle: /mnt/tier2/users/USER/ffast_lammps_live/stop/results/2023/toy.bundle
# Add once to a LAMMPS input, after the atoms exist:   include <this file>
# Run the job as `ffast-lammps srun lmp ...`; the wrapper sets ffast_on and ffast_dir.
# LAMMPS atom types 1..3 are: C H O
# To change a setting for one input, define it before the include line
# (LAMMPS keeps the first definition of an index variable), e.g.
#   variable ffast_stop_on_alarm index 1
variable ffast_on    index 0
variable ffast_every index 100
variable ffast_persist_ps    index 5   # an alarm needs this long a persisting anomaly
variable ffast_stop_on_alarm index 0   # 1: stop LAMMPS when an alarm fires
if "${ffast_on} == 0" then "print 'FFAST: not run through ffast-lammps; monitoring off'" "jump SELF ffast_end"
print """ffast-include 1
bundle /mnt/tier2/users/USER/ffast_lammps_live/stop/results/2023/toy.bundle
every ${ffast_every}
persist_ps ${ffast_persist_ps}
stop_on_alarm ${ffast_stop_on_alarm}
elements C H O
end""" file ${ffast_dir}/include.txt screen no
print """ffast-include 1
bundle /mnt/tier2/users/USER/ffast_lammps_live/stop/results/2023/toy.bundle
every ${ffast_every}
persist_ps ${ffast_persist_ps}
stop_on_alarm ${ffast_stop_on_alarm}
elements C H O
end""" file /home/users/USER/ffast_lammps_live/stop/results/2023/runs/S4_alarm_no_stop/20261106-105509-mel0516-24400-6ff5/include.txt screen no
dump        ffast all custom ${ffast_every} ${ffast_dir}/frames.lammpstrj id type element x y z
dump        ffast all custom 100 ${ffast_dir}/frames.lammpstrj id type element x y z
dump        ffast all custom 100 /home/users/USER/ffast_lammps_live/stop/results/2023/runs/S4_alarm_no_stop/20261106-105509-mel0516-24400-6ff5/frames.lammpstrj id type element x y z
dump_modify ffast sort id flush yes element C H O time yes units yes format float %.17g
