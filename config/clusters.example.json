{
  "profiles": [
    {
      "name": "Example HPC (GPU)",
      "host": "login.example-hpc.org",
      "username": "<your-username>",
      "identity_file": "~/.ssh/<your-ssh-key>",
      "ffast_server_cmd": "module purge && module load Python/3.11 && source /path/to/ffast_env/bin/activate && ffast-server",
      "partition": "gpu",
      "account": "<your-account>",
      "qos": "<your-qos>",
      "job_name": "ffast",
      "cores": 1,
      "cpus_per_task": 16,
      "ntasks_per_node": 1,
      "gpus_per_task": 1,
      "gpu_count": 0,
      "memory_mb": 8192,
      "time_limit": "00:30:00",
      "snapshot_interval_minutes": 5
    },
    {
      "name": "Example HPC (auto-provision)",
      "host": "login.example-hpc.org",
      "username": "<your-username>",
      "identity_file": "~/.ssh/<your-ssh-key>",
      "provision": true,
      "modules": ["Python/3.11", "PyTorch"],
      "venv_path": "~/.ffast/venv",
      "partition": "gpu",
      "account": "<your-account>",
      "qos": "<your-qos>",
      "job_name": "ffast",
      "cpus_per_task": 16,
      "gpus_per_task": 1,
      "memory_mb": 8192,
      "time_limit": "00:30:00",
      "snapshot_interval_minutes": 5
    }
  ]
}
